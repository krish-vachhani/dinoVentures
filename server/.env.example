NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://coinvault:coinvault@localhost:5433/coinvault
TEST_DATABASE_URL=postgresql://coinvault:coinvault@localhost:5433/coinvault_test
JWT_SECRET=dev-only-change-me-32-chars-minimum!!
MOCK_PAYMENT_WEBHOOK_SECRET=dev-only-mock-webhook-secret
# Lets the UI settle mock payments (success/failure). Works in any environment; set false to require the signed webhook.
MOCK_PAYMENT_SIMULATION=true
CLIENT_ORIGIN=http://localhost:5173
# Set true only when a reverse proxy (nginx, load balancer) sits in front of the API.
TRUST_PROXY=false
